// sh_vi_enc — encode `n` as an LEB128 varint, the response side of F1v.
//
// Built through raw memory rather than by concatenating single-byte Bytes.
// mem_write_int_raw lays down 8 native-endian bytes, so a write at offset k
// puts the group byte at k and zeroes k+1..k+7; doing the five writes in
// INCREASING offset order therefore leaves byte k holding group k, because
// every later write only ever clobbers bytes above its own offset. mem_read_raw
// then takes exactly the `w` bytes that are live. The 16-byte reservation is
// sized for the write at offset 4 reaching byte 11.
//
// A negative n is a caller bug and encodes as 0 — every caller here passes a
// length, and a length is never negative.
fn sh_vi_enc(n: Int) -> Bytes {
  let v   = int_max(n, Int(0))
  let res = mem_reserve_raw(Int(16))
  let p   = tuple_field(res, Int(0))

  let g0 = int_mod(v, Int(128))
  let r0 = int_div(v, Int(128))
  let g1 = int_mod(r0, Int(128))
  let r1 = int_div(r0, Int(128))
  let g2 = int_mod(r1, Int(128))
  let r2 = int_div(r1, Int(128))
  let g3 = int_mod(r2, Int(128))
  let r3 = int_div(r2, Int(128))
  let g4 = int_mod(r3, Int(128))

  let w  = if int_eq(r0, Int(0)) { Int(1) } else {
             if int_eq(r1, Int(0)) { Int(2) } else {
               if int_eq(r2, Int(0)) { Int(3) } else {
                 if int_eq(r3, Int(0)) { Int(4) } else { Int(5) } } } }

  // Every group but the last carries the continuation bit.
  let c0 = if int_gt(w, Int(1)) { int_add(g0, Int(128)) } else { int_add(g0, Int(0)) }
  let c1 = if int_gt(w, Int(2)) { int_add(g1, Int(128)) } else { int_add(g1, Int(0)) }
  let c2 = if int_gt(w, Int(3)) { int_add(g2, Int(128)) } else { int_add(g2, Int(0)) }
  let c3 = if int_gt(w, Int(4)) { int_add(g3, Int(128)) } else { int_add(g3, Int(0)) }

  let _w0 = mem_write_int_raw(p, Int(0), c0)
  let _w1 = mem_write_int_raw(p, Int(1), c1)
  let _w2 = mem_write_int_raw(p, Int(2), c2)
  let _w3 = mem_write_int_raw(p, Int(3), c3)
  let _w4 = mem_write_int_raw(p, Int(4), g4)
  mem_read_raw(p, Int(0), w)
}
