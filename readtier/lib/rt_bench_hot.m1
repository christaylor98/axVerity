// rt_bench_hot — the locality control for the W5 sweep. Identical to
// rt_bench_pattern except that every rep queries the SAME key (span = 1), so
// the descent runs against a working set that is warm after the first rep.
//
// This is what distinguishes the two candidate explanations for a per-query
// cost that rises with population: a term that depends on n survives the pin,
// a cold-working-set cost collapses under it.
fn rt_bench_hot(mask: Int, n: Int, reps: Int) -> Int {
  let _m = map_put(Text("rt:bench"), Text("mask"), int_to_str(mask))
  let _n = map_put(Text("rt:bench"), Text("n"), int_to_str(n))
  let _s = map_put(Text("rt:bench"), Text("span"), Text("1"))
  let t0 = now_unix_nanos(Unit())
  let _f = foreach(range(Int(0), reps), rt_bench_step)
  let t1 = now_unix_nanos(Unit())
  let _p = io_println(
    str_concat(Text("hot mask="),
      str_concat(int_to_str(mask),
        str_concat(Text(" ns_per_op="),
          str_concat(int_to_str(int_div(int_sub(t1, t0), int_max(reps, Int(1)))),
            str_concat(Text(" result_card="), int_to_str(rt_out_count(Unit()))))))))
  int_add(Int(0), Int(0))
}
