// rt_qt_fixture — the W4 test graph. Five triples over six entities, chosen so
// that every binding pattern has a distinct, hand-checkable answer:
//
//   a likes b     ids  0 1 2
//   a likes c          0 1 3
//   a knows b          0 4 2
//   d likes b          5 1 2
//   d hates e          5 6 7
//
// The last insert is a deliberate duplicate of the first, so the suite also
// pins that indexing is idempotent per triple.
fn rt_qt_fixture(u: Unit) -> Int {
  let _r  = rt_reset_all(Unit())
  let _1  = rt_insert_names(Text("a"), Text("likes"), Text("b"))
  let _2  = rt_insert_names(Text("a"), Text("likes"), Text("c"))
  let _3  = rt_insert_names(Text("a"), Text("knows"), Text("b"))
  let _4  = rt_insert_names(Text("d"), Text("likes"), Text("b"))
  let _5  = rt_insert_names(Text("d"), Text("hates"), Text("e"))
  let _6  = rt_insert_names(Text("a"), Text("likes"), Text("b"))
  int_add(Int(0), Int(0))
}
