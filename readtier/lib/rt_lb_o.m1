// rt_lb_o — run the lower-bound search over the sealed result set to
// convergence and return the record index it settled on.
//
// One of these per array rather than one taking a name, because loop_while's
// step is a Fn REFERENCE resolved at emit time (iter.rs:3-7) and cannot be
// selected at runtime. rt_lb dispatches the three projections; rt:out has no
// dispatcher because it is the only array of its kind.
fn rt_lb_o(p: Int) -> Int {
  let _l = loop_while(p, rt_bs_more, rt_bs_o, Int(64))
  let r  = mem_read_int_raw(p, Int(0))
  int_add(r, Int(0))
}
