// rt_bench_step — one timed query. The binding pattern and the population are
// read from the bench context (foreach hands the callback only the index), and
// the query arguments are triple j's own coordinates, so every rep has a
// non-empty answer.
//
// `span` is how many distinct keys the reps cycle through. The normal sweep
// sets it to the rep count, so every rep hits a different key. Setting it to 1
// pins every rep to the same key, which is the control that separates a cold
// working set from a cost that depends on total population: an algorithmic
// term in n survives the pin, a memory-hierarchy one does not.
fn rt_bench_step(i: Int) -> Int {
  let mask  = str_to_int(map_get(Text("rt:bench"), Text("mask")))
  let n     = str_to_int(map_get(Text("rt:bench"), Text("n")))
  let tcard = int_max(Int(1), int_div(n, Int(4)))
  let span  = int_max(Int(1), str_to_int(map_get(Text("rt:bench"), Text("span"))))
  let j     = int_mod(int_mod(i, span), int_max(n, Int(1)))
  let s     = str_concat(Text("s"), int_to_str(int_div(j, Int(4))))
  let v     = str_concat(Text("v"), int_to_str(int_mod(j, Int(7))))
  let t     = str_concat(Text("t"), int_to_str(int_mod(j, tcard)))
  let c     = rt_query(mask, s, v, t)
  int_add(c, Int(0))
}
